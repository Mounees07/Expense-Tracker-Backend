# Server
PORT=5000
NODE_ENV=development

# Database (Postgres). URL-encode special characters in the password (# % @ / ?).
DATABASE_URL=postgresql://postgres.project-ref:your_url_encoded_password@aws-1-region.pooler.supabase.com:6543/postgres

# Auth
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# CORS - comma-separated list of allowed frontend origins.
# Requests from any other origin are rejected. Defaults to http://localhost:3000.
ALLOWED_ORIGINS=http://localhost:3000

# Used to build password-reset links in emails.
FRONTEND_URL=http://localhost:3000

# Gmail SMTP for password-reset / statement emails (optional; features degrade gracefully if unset).
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
